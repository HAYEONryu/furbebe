# 새 checkout에서 .env로 복사합니다. 기존 secret 파일은 덮어쓰지 않습니다.
# Backend 최소 개발 설정. 접속 URL은 직접 채웁니다.
APP_ENV=development
DATABASE_URL=
FRONTEND_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# 원천 수집 때만 필요합니다. decoded 또는 percent-encoded service key.
DATA_GO_KR_SERVICE_KEY=

# 선택: 일반 DATABASE_URL 대신 명시적 Supabase DEV target을 사용할 때.
# APP_ENV=development와 프로세스 FURBEBE_DATABASE_TARGET=supabase-dev 필요.
# DATABASE_URL_dev=
# SUPABASE_URL_dev=

# 선택: 운영 실행 환경의 supabase-prod CLI/API에서만 사용.
# APP_ENV=production과 정확한 HTTPS FRONTEND_ORIGIN 필요.
# API/Alembic target selector는 .env가 아닌 프로세스 환경으로 지정합니다.
# DATABASE_URL_prod=
# SUPABASE_URL_prod=https://xhlenzdnqnbczekkovgl.supabase.co
# FURBEBE_PROD_PROJECT_REF=xhlenzdnqnbczekkovgl

# 선택: pool/timeout. 일반 Settings 기본값입니다.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT=5
# DB_POOL_RECYCLE=1800
# DB_CONNECT_TIMEOUT=5
# DB_STATEMENT_TIMEOUT_MS=5000

# SUPABASE publishable/secret/JWKS key와 host/port/database/user 별도 변수는 필수 아님.
# 상세: docs/environment.md
