# Copy to .env. Never commit .env or share the key in chat.
# Use your approved data.go.kr service key (decoded or percent-encoded).
DATA_GO_KR_SERVICE_KEY=

# Backend: development / test / production.
APP_ENV=development
# Set a PostgreSQL connection URL locally. Required in production.
# Use postgresql+psycopg:// and preserve provider-required TLS options.
DATABASE_URL=
# Explicit Supabase DEV operational target (--database-target supabase-dev).
# Copy the URI from DEV Connect: direct or session pooler, port 5432.
DATABASE_URL_dev=
SUPABASE_URL_dev=
# Optional consistency checks against DATABASE_URL_dev.
host_dev=
port_dev=
database_dev=
user_dev=
# Comma-separated exact origins. Production requires explicit HTTPS origins.
FRONTEND_ORIGIN=http://localhost:5173
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=5000

# Pool defaults for DEV. Cloud Run overrides to 3 + 1; sync overrides to 1 + 1.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
# PROD operational commands NEVER fall back to DATABASE_URL or DEV credentials.
# Set only in the protected production environment, not a combined local dotenv.
# DATABASE_URL_prod=
# SUPABASE_URL_prod=
# FURBEBE_PROD_PROJECT_REF=
