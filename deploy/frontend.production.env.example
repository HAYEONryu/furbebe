# 공개 운영 설정 예제. frontend의 공개 env 파일 또는 build 프로세스에 적용합니다.
VITE_API_BASE_URL=https://api.furbebe.site
VITE_SITE_URL=https://furbebe.site

# FURBEBE_BUILD_TARGET=production은 파일만으로 선택되지 않습니다.
# 반드시 build 명령의 프로세스 환경으로 전달합니다.
# 상세 sitemap은 공개 운영 API가 준비된 뒤 사용합니다.
# SITEMAP_API_BASE_URL=https://api.furbebe.site
