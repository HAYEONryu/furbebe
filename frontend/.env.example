# Public build-time configuration only. Never copy the repository root .env here.
VITE_API_BASE_URL=http://127.0.0.1:8080
# Production defaults to https://api.furbebe.site when this variable is unset.
# Override in the build environment for a different public FastAPI origin.

# Canonical public origin (no path). Set explicitly for the deployed domain.
VITE_SITE_URL=https://furbebe.site
# Optional: actual FastAPI list snapshot at build time, not exposed to the browser.
# If omitted, sitemap includes only / and /dogs. A failed snapshot fails the build.
# SITEMAP_API_BASE_URL=http://127.0.0.1:8080
