# Public build-time configuration only. Never copy the repository root .env here.
VITE_API_BASE_URL=http://127.0.0.1:8080
# Production defaults to https://api.furbebe.com when this variable is unset.
# Override in the build environment for a different public FastAPI origin.
VITE_SITE_URL=https://furbebe.com
# Canonical public site origin. Preview hosts are noindex automatically.
