{
  "name": "furbebe-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "react-router dev --host 127.0.0.1 --port 5173",
    "build": "react-router build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check:worker": "wrangler deploy --dry-run",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:check": "node scripts/check-seo.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.56.0",
    "@eslint/js": "^9.39.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^9.39.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "^29.0.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "wrangler": "4.135.0"
  },
  "allowScripts": {
    "workerd@1.20260918.1": true,
    "esbuild@0.28.1": true
  }
}
